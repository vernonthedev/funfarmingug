# Mapbox public (publishable) access token for the embedded map.
# Create a token at https://account.mapbox.com/tokens/ and scope it to your
# site domains. Provide it locally via .env / .env.local and in deployment
# environment variables.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Better Auth (admin panel authentication).
# Generate a secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000

# Convex backend (content database for the admin panel).
# Start locally with: npx convex dev  (creates a deployment URL)
# NEXT_PUBLIC_CONVEX_URL=
